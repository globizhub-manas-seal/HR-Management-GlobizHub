# ============================================================
# TeamHub HRMS - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in all REQUIRED values.
# NEVER commit your actual .env file to version control.
# ============================================================

# DATABASE (REQUIRED)
# Get from: https://console.neon.tech -> Project -> Connection Details
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require&channel_binding=require"

# EMAIL - Resend (REQUIRED in production)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=TeamHub HRMS <noreply@yourdomain.com>

# AWS S3 File Storage (set AWS_S3_MOCK=true to skip real S3)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="hrms-uploads-bucket"
AWS_S3_MOCK="true"

# SECURITY KEYS (REQUIRED - generate with: node -e "require('crypto').randomBytes(32).toString('hex')")
# JWT_SECRET: minimum 64 hex chars (32 bytes)
JWT_SECRET="your-strong-64-hex-char-jwt-secret-here"
# ENCRYPTION_KEY: EXACTLY 64 hex chars (32 bytes) for AES-256
# Encrypts: bank accounts, PAN, Aadhaar, IFSC, UAN numbers
ENCRYPTION_KEY="your-strong-64-hex-char-encryption-key-here"

# FRONTEND (REQUIRED for CORS and email magic links)
FRONTEND_URL="https://your-frontend-domain.vercel.app"
FRONTEND_ORIGIN="https://your-frontend-domain.vercel.app"

# SENTRY (OPTIONAL but recommended in production)
# SENTRY_DSN="https://xxxx@oxxxx.ingest.sentry.io/xxxx"
