# ============================================================
# GlobizHR - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in all REQUIRED values.
# NEVER commit your actual .env file to version control.
# ============================================================

# DATABASE (REQUIRED)
# Get from: https://console.neon.tech -> Project -> Connection Details
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require&channel_binding=require"
# Connection pool size per API process (default 10). Total connections
# across replicas must stay below Postgres max_connections (default 100).
DB_POOL_MAX="10"

# EMAIL - Resend (REQUIRED in production)
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_your-resend-api-key-here"
RESEND_FROM_EMAIL="HRMS <noreply@example.com>"
SENDER_EMAIL="HRMS <noreply@example.com>"

# AWS S3 File Storage (set AWS_S3_MOCK=true to skip real S3)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="hrms-uploads-bucket"
# S-11: AWS_S3_MOCK=true is only allowed in development/testing. It must be set to "false" (or unset) in production.`r`nAWS_S3_MOCK="false"

# SECURITY KEYS (REQUIRED - generate with: node -e "require('crypto').randomBytes(32).toString('hex')")
# JWT_SECRET: minimum 64 hex chars (32 bytes)
JWT_SECRET="your-strong-64-hex-char-jwt-secret-here"
# ENCRYPTION_KEY: EXACTLY 64 hex chars (32 bytes) for AES-256
# Encrypts: bank accounts, PAN, Aadhaar, IFSC, UAN numbers
ENCRYPTION_KEY="your-strong-64-hex-char-encryption-key-here"

# FRONTEND (REQUIRED for CORS and email magic links)
FRONTEND_URL="https://your-frontend-domain.vercel.app"
FRONTEND_ORIGIN="https://your-frontend-domain.vercel.app"

# ============================================================
# PAYMENTS — Razorpay (https://dashboard.razorpay.com/app/keys)
# All amounts/limits are configured from the Super Admin console
# (SystemConfig table) — nothing below changes pricing.
# ============================================================
RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
# Webhook URL to configure in Razorpay dashboard:
#   https://<your-backend-domain>/platform/billing/webhook
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxx"
# NEVER set SANDBOX_PAYMENTS=true in production (dev-only payment simulator)
SANDBOX_PAYMENTS="false"

# Platform bootstrap super admin (created on first boot if not present)
PLATFORM_SUPER_ADMIN_EMAIL="superadmin@globizhr.com"
PLATFORM_SUPER_ADMIN_PASSWORD="change-me-immediately"

# SENTRY (OPTIONAL but recommended in production)
# SENTRY_DSN="https://xxxx@oxxxx.ingest.sentry.io/xxxx"
